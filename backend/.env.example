# Copy to backend/.env and replace all placeholders.
# The MongoDB account must have readWrite on climate_hazard_analyzer.
# URL-encode the password if it includes reserved URI characters.
MONGODB_URI=mongodb://APP_USERNAME:URL_ENCODED_PASSWORD@127.0.0.1:27017/climate_hazard_analyzer?authSource=climate_hazard_analyzer
MONGODB_DATABASE=climate_hazard_analyzer

# Used by scripts/deploy-ec2.sh for tests only on the EC2 host.
# Configure a separate test user limited to climate_hazard_analyzer_test.
MONGODB_TEST_URI=mongodb://TEST_USERNAME:URL_ENCODED_PASSWORD@127.0.0.1:27017/climate_hazard_analyzer_test?authSource=climate_hazard_analyzer_test
